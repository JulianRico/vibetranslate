# ============================================================================
# ViBeTranslate Pro Studio - Variables de Entorno (Plantilla de Ejemplo)
# ============================================================================
# Copia este archivo como `.env` y reemplaza los valores ficticios por tus
# propias claves reales. El archivo `.env` nunca se sube a Git ni se empaqueta.
# ============================================================================

# Google Gemini API Key (para Gemini 3.5 Transcribe y Gemini Live Audio)
# Consíguela en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyDummyKeyReplaceWithYourOwn00000000

# Groq Cloud API Key (para Whisper Large v3 Turbo, traducción LLM e Interviewer)
# Consíguela gratis en: https://console.groq.com/keys
GROQ_API_KEY=gsk_dummy_replace_with_your_groq_api_key_000000000000

# Fish Audio AI API Key (para síntesis TTS y clonación de tu propia voz)
# Consíguela en: https://fish.audio
FISH_API_KEY=00000000000000000000000000000000

# ID de tu modelo de voz clonada en Fish Audio (usa "default" para voz estándar)
FISH_VOICE_MODEL_ID=default

# Modelo de síntesis por defecto en Fish Audio (s2.1-pro-free | s2.1-pro | s2-pro)
FISH_MODEL=s2.1-pro-free

# Microservicio local opcional VoxCPM TTS
VOXCPM_HOST=127.0.0.1
VOXCPM_PORT=8765

# Microservicio opcional NVIDIA PersonaPlex Full-Duplex (Estudio de Práctica en tiempo real)
# PERSONAPLEX_HOST=127.0.0.1
# PERSONAPLEX_PORT=8998
# PERSONAPLEX_VOICE=NATF2

# Rutas opcionales en desarrollo y pruebas automáticas (descomentar solo si se requiere)
# VIBE_MODELS_DIR=./.models
# VIBE_SESSIONS_DIR=./test-sessions
