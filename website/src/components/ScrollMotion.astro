<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const media = gsap.matchMedia();
  media.add({
    desktop: '(min-width: 1000px) and (min-height: 760px)',
    motion: '(prefers-reduced-motion: no-preference)',
    reduced: '(prefers-reduced-motion: reduce)',
  }, (context) => {
    const { desktop, reduced } = context.conditions!;
    if (reduced) return;

    gsap.to('.hero-meeting-body', {
      y: 120,
      scale: 0.94,
      opacity: 0.25,
      ease: 'none',
      scrollTrigger: {
        id: 'hero-scroll',
        trigger: '.cinematic-hero-wrapper',
        start: 'top top',
        end: 'bottom top',
        scrub: 0.5,
      },
    });

    const demo = document.querySelector('.demo-layout');
    if (demo && desktop) {
      gsap.timeline({
        scrollTrigger: {
          id: 'product-scroll',
          trigger: demo,
          start: 'top 100px',
          end: '+=480',
          pin: true,
          scrub: 0.65,
          invalidateOnRefresh: true,
        },
      })
        .fromTo('.demo-image-stage', { y: 32, rotation: -3, scale: 0.88 }, { y: -8, rotation: 0, scale: 1.03, ease: 'none' }, 0)
        .fromTo('.demo-context dl > div', { x: 36, opacity: 0.35 }, { x: 0, opacity: 1, stagger: 0.18, ease: 'none' }, 0);
    }

    const revealTargets = gsap.utils.toArray<HTMLElement>(
      '.section-header-editorial, .demo-heading, .faq-header-center, [data-scroll-reveal], .step-editorial-card, .feature-editorial-card, .pricing-card, .request-context, .request-form',
    );
    revealTargets.sort((first, second) => first.getBoundingClientRect().top - second.getBoundingClientRect().top);
    revealTargets.forEach(target => {
      gsap.fromTo(target, { y: 52, opacity: 0 }, {
        y: 0,
        opacity: 1,
        duration: 0.85,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: target,
          start: 'clamp(top 92%)',
          toggleActions: 'play none none reverse',
        },
      });
    });

    gsap.utils.toArray<HTMLImageElement>('[data-scroll-image]').forEach(image => {
      gsap.fromTo(image, { scale: 1.16, yPercent: -3 }, {
        scale: 1.10,
        yPercent: 3,
        ease: 'none',
        scrollTrigger: {
          trigger: image.parentElement,
          start: 'top bottom',
          end: 'bottom top',
          scrub: 0.7,
        },
      });
    });
  });

  const refresh = () => ScrollTrigger.refresh();
  document.fonts.ready.then(refresh);
  document.querySelectorAll('img').forEach(image => {
    if (!image.complete) image.addEventListener('load', refresh, { once: true });
  });
  const languageObserver = new MutationObserver(refresh);
  languageObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['lang'] });
  document.querySelector('.demo-tabs')?.addEventListener('click', refresh);
  document.querySelector('.faq-accordion-wrapper')?.addEventListener('transitionend', refresh);
  document.addEventListener('astro:before-swap', () => {
    media.revert();
    languageObserver.disconnect();
  }, { once: true });
</script>