---
import { t } from '../i18n';
---
<section id="benefits" class="section-editorial">
  <div class="container">
    <div class="section-header-editorial">
      <div class="section-label" data-i18n="feat-label">{t("feat-label")}</div>
      <h2>
        <span data-i18n="feat-title-a">{t("feat-title-a")}</span>
        <span style="font-weight: 400;" data-i18n="feat-title-b">{t("feat-title-b")}</span>
      </h2>
      <p class="features-subtitle" data-i18n="feat-subtitle">{t("feat-subtitle")}</p>
    </div>
    <!-- 6 Taupe Feature Cards (#f5f3f1, 20px radius) -->
    <div class="features-editorial-grid">
      <div class="card-taupe feature-editorial-card">
        <div class="card-top-row">
          <span class="feat-num">01</span>
          <span class="mono-tag" data-i18n="f-1-badge">{t("f-1-badge")}</span>
        </div>
        <h3 class="feature-title" data-i18n="f-1-title">{t("f-1-title")}</h3>
        <p class="feature-desc" data-i18n="f-1-desc">{t("f-1-desc")}</p>
        <img class="feature-shot" src="/images/w04-subtitulos-flotantes.png" width="760" height="220" loading="lazy" alt="Ventana de subtítulos flotantes de ViBeTranslate Pro con las últimas frases traducidas">
      </div>
      <div class="card-taupe feature-editorial-card">
        <div class="card-top-row">
          <span class="feat-num">02</span>
          <span class="mono-tag" data-i18n="f-2-badge">{t("f-2-badge")}</span>
        </div>
        <h3 class="feature-title" data-i18n="f-2-title">{t("f-2-title")}</h3>
        <p class="feature-desc" data-i18n="f-2-desc">{t("f-2-desc")}</p>
        <img class="feature-shot" src="/images/m06-en-vivo-claro.png" width="424" height="755" loading="lazy" alt={t("shot-m06-alt")} data-i18n-alt="shot-m06-alt">
      </div>
      <div class="card-taupe feature-editorial-card">
        <div class="card-top-row">
          <span class="feat-num">03</span>
          <span class="mono-tag" data-i18n="f-3-badge">{t("f-3-badge")}</span>
        </div>
        <h3 class="feature-title" data-i18n="f-3-title">{t("f-3-title")}</h3>
        <p class="feature-desc" data-i18n="f-3-desc">{t("f-3-desc")}</p>
      </div>
      <div class="card-taupe feature-editorial-card">
        <div class="card-top-row">
          <span class="feat-num">04</span>
          <span class="mono-tag" data-i18n="f-4-badge">{t("f-4-badge")}</span>
        </div>
        <h3 class="feature-title" data-i18n="f-4-title">{t("f-4-title")}</h3>
        <p class="feature-desc" data-i18n="f-4-desc">{t("f-4-desc")}</p>
        <img class="feature-shot" src="/images/m08-practica-preparacion.png" width="424" height="755" loading="lazy" alt={t("shot-m08-alt")} data-i18n-alt="shot-m08-alt" />
      </div>
      <div class="card-taupe feature-editorial-card">
        <div class="card-top-row">
          <span class="feat-num">05</span>
          <span class="mono-tag" data-i18n="f-5-badge">{t("f-5-badge")}</span>
        </div>
        <h3 class="feature-title" data-i18n="f-5-title">{t("f-5-title")}</h3>
        <p class="feature-desc" data-i18n="f-5-desc">{t("f-5-desc")}</p>
      </div>
      <div class="card-taupe feature-editorial-card">
        <div class="card-top-row">
          <span class="feat-num">06</span>
          <span class="mono-tag" data-i18n="f-6-badge">{t("f-6-badge")}</span>
        </div>
        <h3 class="feature-title" data-i18n="f-6-title">{t("f-6-title")}</h3>
        <p class="feature-desc" data-i18n="f-6-desc">{t("f-6-desc")}</p>
      </div>
    </div>
  </div>
  <hr class="hairline-divider" style="margin-top: var(--spacing-96);" />
</section>

<style>
  .features-subtitle {
    margin-top: var(--spacing-12);
    max-width: 640px;
  }

  .features-editorial-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @media (max-width: 980px) {
    .features-editorial-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .features-editorial-grid {
      grid-template-columns: 1fr;
    }
  }

  .feature-editorial-card {
    display: flex;
    flex-direction: column;
    padding: 38px 34px;
    gap: 20px;
    border-radius: 20px;
    background-color: var(--color-warm-taupe);
    border: 1px solid var(--color-stone);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .feature-editorial-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
  }

  @media (max-width: 768px) {
    .feature-editorial-card {
      padding: 28px 24px;
      gap: 16px;
    }
  }

  .card-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2px;
  }

  .feat-num {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--color-ash);
    letter-spacing: 0.08em;
  }

  .feature-title {
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 600;
    color: var(--color-ink);
    line-height: 1.35;
    margin: 0;
  }

  .feature-desc {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--color-graphite);
    margin: 0;
  }

  .feature-shot {
    display: block;
    width: 100%;
    max-width: 200px;
    height: auto;
    margin-top: 20px;
    border-radius: 16px;
    border: 1px solid var(--color-stone);
  }
</style>
