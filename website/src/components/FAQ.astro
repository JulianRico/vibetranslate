              <line x1="12" y1="5" x2="12" y2="19" class="icon-line-v"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
          </span>
        </button>
        <div class="faq-accordion-content">
          <div class="faq-answer-inner">
