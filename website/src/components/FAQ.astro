  <hr class="hairline-divider" style="margin-top: var(--spacing-96);" />
</section>

<style>
  .faq-header-center {
    text-align: center;
    max-width: 780px;
    margin: 0 auto var(--spacing-48) auto;
  }

  .faq-subtitle {
    margin-top: var(--spacing-12);
    font-size: 16.5px;
    color: var(--color-smoke);
    line-height: var(--leading-body);
  }

  /* Accordion Layout */
  .faq-accordion-wrapper {
    max-width: 840px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-stone);
  }

  .faq-accordion-item {
    border-bottom: 1px solid var(--color-stone);
    transition: background-color 0.2s ease;
  }

  .faq-accordion-item:hover {
    background-color: rgba(245, 243, 241, 0.4);
  }

  .faq-accordion-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 24px 8px;
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: all 0.2s ease;
  }

  .faq-question-text {
    font-family: var(--font-body);
    font-size: 17.5px;
    font-weight: 500;
    color: var(--color-ink);
    line-height: 1.4;
  }

  .faq-toggle-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-pill);
    background-color: var(--color-warm-taupe);
    color: var(--color-ink);
    flex-shrink: 0;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .faq-accordion-item.is-open .faq-toggle-icon {
    background-color: var(--color-ink);
    color: #ffffff;
    transform: rotate(45deg);
  }

  /* Content Height Collapse Animation */
  .faq-accordion-content {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .faq-accordion-item.is-open .faq-accordion-content {
    grid-template-rows: 1fr;
  }

  .faq-answer-inner {
    overflow: hidden;
  }

  .faq-answer-inner p {
    padding: 0 8px 24px 8px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-graphite);
    margin: 0;
  }
</style>

<!-- Accordion Interactive JavaScript -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const items = document.querySelectorAll('.faq-accordion-item');

    items.forEach(item => {
      const trigger = item.querySelector('.faq-accordion-trigger');
      if (!trigger) return;

      trigger.addEventListener('click', () => {
        const isOpen = item.classList.contains('is-open');

        // Close other accordion items for clean single-view or allow multi
        items.forEach(otherItem => {
          if (otherItem !== item) {
            otherItem.classList.remove('is-open');
            const otherTrigger = otherItem.querySelector('.faq-accordion-trigger');
            if (otherTrigger) otherTrigger.setAttribute('aria-expanded', 'false');
          }
        });

        if (isOpen) {
          item.classList.remove('is-open');
          trigger.setAttribute('aria-expanded', 'false');
        } else {
          item.classList.add('is-open');
          trigger.setAttribute('aria-expanded', 'true');
        }
      });
    });
  });
</script>
