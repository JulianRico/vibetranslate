---
import { t } from '../i18n';
---
<section id="faq" class="section-editorial faq-section">
  <div class="container">
    <!-- Header -->
    <div class="section-header-editorial faq-header-center">
      <div class="section-label" data-i18n="faq-label">{t("faq-label")}</div>
      <h2>
        <span data-i18n="faq-title-a">{t("faq-title-a")}</span>
        <span style="font-weight: 400;" data-i18n="faq-title-b">{t("faq-title-b")}</span>
      </h2>
      <p class="faq-subtitle" data-i18n="faq-subtitle">{t("faq-subtitle")}</p>
    </div>
    <!-- Elegant Minimalist Accordion -->
    <div class="faq-accordion-wrapper">

      <div class="faq-accordion-item is-open">
        <button type="button" class="faq-accordion-trigger" aria-expanded="true">
          <span class="faq-question-text" data-i18n="faq-q-1">{t("faq-q-1")}</span>
          <span class="faq-toggle-icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19" class="icon-line-v"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
          </span>
        </button>
        <div class="faq-accordion-content">
          <div class="faq-answer-inner">
            <p data-i18n="faq-a-1">{t("faq-a-1")}</p>
          </div>
        </div>
      </div>

      <div class="faq-accordion-item">
        <button type="button" class="faq-accordion-trigger" aria-expanded="false">
          <span class="faq-question-text" data-i18n="faq-q-2">{t("faq-q-2")}</span>
          <span class="faq-toggle-icon">
