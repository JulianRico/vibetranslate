---
import { t } from '../i18n';
---

<section id="pricing" class="section-editorial pricing-section">
  <div class="container">

    <!-- Header -->
    <div class="section-header-editorial text-center">
      <div class="section-label" data-i18n="pricing-label">{t("pricing-label")}</div>
      <h2>
        <span data-i18n="pricing-title-a">{t("pricing-title-a")}</span>
        <span style="font-weight: 400;" data-i18n="pricing-title-b">{t("pricing-title-b")}</span>
      </h2>
      <p class="pricing-subtitle" data-i18n="pricing-subtitle">{t("pricing-subtitle")}</p>
    </div>

    <!-- Pricing Cards Grid -->
    <div class="pricing-grid">

      <!-- Plan 1: Suscripción -->
      <div class="card-taupe pricing-card highlighted-plan">
        <div class="plan-header">
          <span class="plan-badge-dark" data-i18n="pl-sub-badge">{t("pl-sub-badge")}</span>
          <h3 class="plan-name" data-i18n="pl-sub-name">{t("pl-sub-name")}</h3>
          <p class="plan-desc" data-i18n="pl-sub-desc">{t("pl-sub-desc")}</p>
        </div>
        <div class="price-box">
          <div class="price-row">
            <span class="currency">USD</span>
            <span class="price-val highlight-val">20</span>
            <span class="price-period" data-i18n="pl-period">{t("pl-period")}</span>
          </div>
          <span class="billed-note" data-i18n="billed-monthly-note">{t("billed-monthly-note")}</span>
        </div>
        <div class="plan-features-list">
          <div class="plan-feature-item"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg><span data-i18n="pl-sub-f1">{t("pl-sub-f1")}</span></div>
          <div class="plan-feature-item"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg><span data-i18n="pl-sub-f2">{t("pl-sub-f2")}</span></div>
          <div class="plan-feature-item"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg><span data-i18n="pl-sub-f3">{t("pl-sub-f3")}</span></div>
          <div class="plan-feature-item"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg><span data-i18n="pl-sub-f4">{t("pl-sub-f4")}</span></div>
          <div class="plan-feature-item"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg><span data-i18n="pl-sub-f5">{t("pl-sub-f5")}</span></div>
          <div class="plan-feature-item"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg><span data-i18n="pl-sub-f6">{t("pl-sub-f6")}</span></div>
        </div>
        <a href="#downloads" data-request-audience="individual" class="btn-pill btn-pill-primary btn-plan-action" data-i18n="pl-sub-btn">{t("pl-sub-btn")}</a>
      </div>

      <!-- Plan 2: Empresarial -->
      <div class="card-taupe pricing-card">
        <div class="plan-header">
          <span class="plan-badge" data-i18n="pl-biz-badge">{t("pl-biz-badge")}</span>
          <h3 class="plan-name" data-i18n="pl-biz-name">{t("pl-biz-name")}</h3>
          <p class="plan-desc" data-i18n="pl-biz-desc">{t("pl-biz-desc")}</p>
        </div>
        <div class="price-box">
          <div class="price-row">
            <span class="price-val" style="font-size: 34px;" data-i18n="pl-biz-price">{t("pl-biz-price")}</span>
          </div>
          <span class="billed-note" data-i18n="pl-biz-note">{t("pl-biz-note")}</span>
        </div>
        <div class="plan-features-list">
          <div class="plan-feature-item"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg><span data-i18n="pl-biz-f1">{t("pl-biz-f1")}</span></div>
          <div class="plan-feature-item"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg><span data-i18n="pl-biz-f2">{t("pl-biz-f2")}</span></div>
          <div class="plan-feature-item"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg><span data-i18n="pl-biz-f3">{t("pl-biz-f3")}</span></div>
        </div>
        <p id="contacto" class="billed-note contact-placeholder" data-i18n="contact-placeholder">{t("contact-placeholder")}</p>
        <a href="#downloads" data-request-audience="team" class="btn-pill btn-pill-secondary btn-plan-action" data-i18n="pl-biz-btn">{t("pl-biz-btn")}</a>
      </div>

    </div>
  </div>
</section>

<style>
  .text-center {
    text-align: center;
    max-width: 820px;
    margin: 0 auto var(--spacing-48) auto;
  }

  .pricing-subtitle {
    margin-top: var(--spacing-16);
    font-size: 16.5px;
    line-height: var(--leading-body);
    color: var(--color-smoke);
  }

  /* Monthly / Annual Switcher */
  .billing-toggle-wrapper {
    display: flex;
    justify-content: center;
    margin-top: var(--spacing-32);
  }

  .billing-toggle-pill {
    display: inline-flex;
    align-items: center;
    background-color: var(--color-warm-taupe);
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-pill);
    padding: 4px;
    gap: 4px;
  }

  .toggle-choice {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 18px;
    border-radius: var(--radius-pill);
    font-family: var(--font-body);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--color-smoke);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .toggle-choice.active {
    background-color: #ffffff;
    color: var(--color-ink);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
  }

  .discount-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    background-color: var(--color-ink);
    color: #ffffff;
    padding: 2px 6px;
    border-radius: var(--radius-pill);
    letter-spacing: 0.04em;
  }

  /* Pricing Cards Grid */
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 880px;
    margin: 0 auto;
    gap: 24px;
    align-items: stretch;
  }

  @media (max-width: 980px) {
    .pricing-grid {
      grid-template-columns: 1fr;
    }
  }

  .pricing-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 40px 32px;
    border-radius: 8px;
    gap: 24px;
  }

  @media (max-width: 768px) {
    .pricing-card {
      padding: 30px 24px;
    }
  }

  .highlighted-plan {
    background-color: #ffffff;
    border: 2px solid var(--color-ink);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.06);
    transform: none;
  }

  @media (max-width: 980px) {
    .highlighted-plan {
      transform: none;
    }
  }

  .popular-ribbon {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background-color: var(--color-ink);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    padding: 4px 14px;
    border-radius: var(--radius-pill);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .plan-header {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .plan-badge {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 600;
    color: var(--color-smoke);
    background-color: var(--color-eggshell);
    border: 1px solid var(--color-stone);
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    width: fit-content;
  }

  .plan-badge-dark {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 600;
    color: #ffffff;
    background-color: var(--color-ink);
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    width: fit-content;
  }

  .plan-name {
    font-family: var(--font-body);
    font-size: 24px;
    font-weight: 600;
    color: var(--color-ink);
  }

  .plan-desc {
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-smoke);
  }

  /* Price Box */
  .price-box {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 0;
    border-top: 1px solid var(--color-stone);
    border-bottom: 1px solid var(--color-stone);
  }

  .price-row {
    display: flex;
    align-items: baseline;
    gap: 4px;
  }

  .currency {
    font-size: 20px;
    font-weight: 600;
    color: var(--color-ink);
  }

  .price-val {
    font-family: var(--font-body);
    font-size: 44px;
    font-weight: 700;
    line-height: 1;
    color: var(--color-ink);
  }

  .price-period {
    font-size: 14px;
    color: var(--color-smoke);
  }

  .billed-note {
    font-size: 12px;
    color: var(--color-graphite);
  }

  /* Features List */
  .plan-features-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  .plan-feature-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--color-graphite);
  }

  .check-icon {
    color: var(--color-ink);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .btn-plan-action {
    width: 100%;
    justify-content: center;
    padding: 12px;
    font-size: 14px;
  }

  /* Guarantee Banner */
  .guarantee-box {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-around;
    gap: 20px;
    margin-top: var(--spacing-40);
    padding: var(--spacing-20) var(--spacing-32);
    border-radius: var(--radius-cards);
  }

  .guarantee-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--color-graphite);
  }

  .contact-placeholder {
    color: var(--color-ember-orange);
    font-weight: 500;
    margin: 4px 0 16px 0;
  }
</style>

<!-- Client-side Interactive Price Switcher Script -->
