---
import { t } from '../i18n';
const outcomes = [1, 2, 3];
---

<section id="story" class="section-editorial conversation-story">
  <div class="container">
    <div class="story-intro" data-scroll-reveal>
      <div>
        <p class="section-label" data-i18n="ps-label">{t('ps-label')}</p>
        <h2><span data-i18n="ps-title-a">{t('ps-title-a')}</span> <span data-i18n="ps-title-b">{t('ps-title-b')}</span></h2>
      </div>
      <p class="story-lead" data-i18n="ps-subtitle">{t('ps-subtitle')}</p>
    </div>
    <div id="solucion" class="story-outcomes">
      {outcomes.map(number => (
        <article class="story-outcome" data-scroll-reveal>
          <span class="outcome-index" aria-hidden="true">0{number}</span>
          <h3 data-i18n={`so-${number}-title`}>{t(`so-${number}-title`)}</h3>
          <p data-i18n={`so-${number}-desc`}>{t(`so-${number}-desc`)}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .conversation-story { background: #f9faf8; }
  .story-intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr); gap: 80px; align-items: end; margin-bottom: 56px; }
  h2 { font-family: var(--font-serif); font-size: 46px; font-weight: 400; line-height: 1.12; }
  .story-lead { font-size: 18px; line-height: 1.7; }
  .story-outcomes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; }
  .story-outcome { border-top: 1px solid #becdc3; padding-top: 24px; }
  .outcome-index { font-family: var(--font-mono); color: #527060; font-size: 12px; }
  h3 { font-family: var(--font-body); font-size: 18px; font-weight: 600; margin: 20px 0 12px; }
  .story-outcome p { font-size: 14px; line-height: 1.7; }
  @media (max-width: 860px) {
    .story-intro, .story-outcomes { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    h2 { font-size: 34px; }
    .story-lead { font-size: 16px; }
  }
</style>