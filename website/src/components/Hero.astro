---
import { translations, t } from '../i18n';
---
<section class="cinematic-hero-wrapper">

  <!-- Atmospheric Deep Liquid Backdrop -->
  <div class="hero-atmosphere-backdrop"></div>

  <!-- 2. Main Full-Screen Flex Column Content -->
  <div class="hero-foreground-content">

    <!-- Top Liquid Glass Navigation Bar -->
    <header class="nav-bar-outer">
      <div class="nav-bar-inner liquid-glass">

        <!-- Left: Logo & Title (Clean Solar Globe Icon) -->
        <a href="#" class="brand-link">
          <div class="logo-circle">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <ellipse cx="12" cy="12" rx="4" ry="10"></ellipse>
              <line x1="2" y1="12" x2="22" y2="12"></line>
            </svg>
          </div>
          <span class="brand-name">ViBeTranslate Pro</span>
        </a>

        <!-- Center: Clean Essential Links -->
        <div class="nav-center-links">
          <a href="#story" class="nav-item" data-i18n="nav-problem">{t("nav-problem")}</a>
          <a href="#casos" class="nav-item" data-i18n="nav-uses">{t("nav-uses")}</a>
          <a href="#how-it-works" class="nav-item" data-i18n="nav-how">{t("nav-how")}</a>
          <a href="#demo" class="nav-item" data-i18n="nav-comp">{t("nav-comp")}</a>
          <a href="#pricing" class="nav-item" data-i18n="nav-pricing">{t("nav-pricing")}</a>
        </div>

        <!-- Right: Language Switcher & Tikal Attribution -->
        <div class="nav-right-actions">

          <!-- Language Toggle Pill -->
          <button type="button" id="lang-toggle-btn" class="lang-switcher-pill" title="Cambiar idioma / Switch language">
            <span class="lang-choice active" id="lang-es">ES</span>
            <span class="lang-divider">/</span>
            <span class="lang-choice" id="lang-en">EN</span>
          </button>

          <a href="https://tikal.com.co" target="_blank" rel="noopener noreferrer" class="nav-text-btn desktop-only" title="Desarrollado por Tikal Solutions">
            Tikal Solutions
          </a>

          <!-- Mobile Hamburger Toggle Button -->
          <button type="button" id="mobile-menu-toggle" class="mobile-menu-btn" aria-label="Abrir menú / Open menu" aria-expanded="false" aria-controls="mobile-dropdown-menu">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" id="icon-menu-bars">
              <line x1="4" y1="7" x2="20" y2="7"></line>
              <line x1="4" y1="12" x2="20" y2="12"></line>
              <line x1="4" y1="17" x2="20" y2="17"></line>
            </svg>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" id="icon-menu-close" style="display: none;">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

      </div>

      <!-- Mobile Dropdown Panel -->
      <div id="mobile-dropdown-menu" class="mobile-dropdown-panel liquid-glass">
        <nav class="mobile-links-list">
          <a href="#story" class="mobile-nav-link" data-i18n="nav-problem">{t("nav-problem")}</a>
          <a href="#casos" class="mobile-nav-link" data-i18n="nav-uses">{t("nav-uses")}</a>
          <a href="#how-it-works" class="mobile-nav-link" data-i18n="nav-how">{t("nav-how")}</a>
          <a href="#demo" class="mobile-nav-link" data-i18n="nav-comp">{t("nav-comp")}</a>
          <a href="#pricing" class="mobile-nav-link" data-i18n="nav-pricing">{t("nav-pricing")}</a>
          <a href="#downloads" class="mobile-nav-link" data-i18n="nav-dl">{t("nav-dl")}</a>
        </nav>
        <div class="mobile-menu-footer">
          <a href="#downloads" class="btn-liquid-pill mobile-download-btn" data-i18n="nav-btn-dl">{t("nav-btn-dl")}</a>
        </div>
      </div>

    </header>

    <!-- Center Hero Meeting Area -->
    <div class="hero-meeting-body">

      <!-- Live Meeting Call Tag -->
      <div class="meeting-status-tag liquid-glass">
        <span data-i18n="hero-meeting-tag">{t("hero-meeting-tag")}</span>
      </div>

      <!-- Instrument Serif Display Heading -->
      <h1 class="hero-instrument-title" id="hero-main-title">ViBeTranslate Pro</h1>
      <p class="hero-promise" data-i18n="hero-title">{t("hero-title")}</p>
      <p class="hero-description" data-i18n="hero-subtext">{t("hero-subtext")}</p>

      <!-- Meeting Floating Subtitle HUD (.liquid-glass) -->
      <div class="meeting-hud-box liquid-glass">
        <div class="hud-header-line">
          <div class="hud-channel-group">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
              <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
              <line x1="12" y1="19" x2="12" y2="23"></line>
              <line x1="8" y1="23" x2="16" y2="23"></line>
            </svg>
            <span class="hud-channel" data-i18n="hud-channel">{t("hud-channel")}</span>
          </div>
          <span class="hud-badge-latency" data-i18n="hud-badge-active">{t("hud-badge-active")}</span>
        </div>
        <div class="hud-subtitles-stream">
          <p class="subtitle-es" lang="es">"El equipo ya puede revisar la propuesta."</p>
          <p class="subtitle-en" lang="en">"The team can now review the proposal."</p>
        </div>
      </div>

      <!-- Primary actions: download (existing target) and plans -->
      <div class="hero-cta-wrapper">
        <div class="hero-cta-buttons">
          <a href="#downloads" class="btn-pill btn-pill-primary" data-i18n="hero-btn-dl">{t("hero-btn-dl")}</a>
          <a href="#demo" class="btn-pill btn-pill-secondary" data-i18n="hero-btn-plans">{t("hero-btn-plans")}</a>
        </div>
        <p class="cta-subtext" data-i18n="hero-access-note">{t("hero-access-note")}</p>
        <p class="cta-platform" data-i18n="cta-input-val">{t("cta-input-val")}</p>
      </div>

    </div>

    <!-- Bottom Meeting Call Controls (Microphone, Camera, Captions, Hangup - Solar SVGs) -->
    <div class="meeting-call-controls-bar" hidden aria-hidden="true" inert>
      <div class="meeting-dock-inner liquid-glass">

        <!-- Mic Active -->
        <button type="button" class="dock-btn active" title="Micrófono Virtual">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
            <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
            <line x1="12" y1="19" x2="12" y2="23"></line>
            <line x1="8" y1="23" x2="16" y2="23"></line>
          </svg>
        </button>

        <!-- Video Camera -->
        <button type="button" class="dock-btn" title="Cámara">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="23 7 16 12 23 17 23 7"></polygon>
            <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
          </svg>
        </button>

        <!-- Subtitles CC -->
        <button type="button" class="dock-btn active" title="Subtítulos en Vivo">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="3"></rect>
            <path d="M7 15h2a2 2 0 0 0 2-2v-2a2 2 0 0 0-2-2H7v6z"></path>
            <path d="M15 15h2a2 2 0 0 0 2-2v-2a2 2 0 0 0-2-2h-2v6z"></path>
          </svg>
        </button>

        <!-- Share Screen -->
        <button type="button" class="dock-btn" title="Compartir Pantalla">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="3" width="20" height="14" rx="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
            <polyline points="9 9 12 6 15 9"></polyline>
            <line x1="12" y1="6" x2="12" y2="13"></line>
          </svg>
        </button>

        <!-- End Call -->
        <button type="button" class="dock-btn end-call" title="Desconectar">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10.68 13.31a16 16 0 0 0 3.41 2.6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7 2 2 0 0 1 1.72 2v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.42 19.42 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91"></path>
            <line x1="23" y1="1" x2="1" y2="23"></line>
          </svg>
        </button>

      </div>
    </div>

  </div>

</section>

<style>
  .cinematic-hero-wrapper {
    position: relative;
    min-height: 0;
    background-color: #000000;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* Atmospheric Deep Liquid Backdrop */
  .hero-atmosphere-backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: #102e2b;
    z-index: 0;
    pointer-events: none;
  }

  /* 2. Main Flex Column */
  .hero-foreground-content {
    position: relative;
    z-index: 10;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 24px;
  }

  /* Navigation Bar */
  .nav-bar-outer {
    position: relative;
    z-index: 20;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .nav-bar-inner {
    border-radius: var(--radius-pill);
    padding: 12px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    color: #ffffff;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #ffffff;
    flex-shrink: 0;
  }

  .logo-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
  }

  .brand-name {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 16px;
    letter-spacing: 0;
    color: #ffffff;
  }

  .nav-center-links {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .nav-item {
    font-size: 14px;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.75);
    transition: color 0.2s ease;
    white-space: nowrap;
  }

  .nav-item:hover {
    color: #ffffff;
  }

  .nav-right-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }

  /* Language Switcher Pill */
  .lang-switcher-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 11px;
    transition: all 0.2s ease;
  }

  .lang-switcher-pill:hover {
    background: rgba(255, 255, 255, 0.16);
  }

  .lang-choice {
    color: rgba(255, 255, 255, 0.5);
    font-weight: 600;
  }

  .lang-choice.active {
    color: #ffffff;
  }

  .lang-divider {
    color: rgba(255, 255, 255, 0.3);
  }

  .nav-text-btn {
    font-size: 14px;
    font-weight: 400;
    color: #ffffff;
  }

  .btn-liquid-pill {
    padding: 8px 18px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    font-size: 13px;
    font-weight: 500;
    border: 1px solid rgba(255, 255, 255, 0.25);
    transition: all 0.2s ease;
  }

  .btn-liquid-pill:hover {
    background: rgba(255, 255, 255, 0.25);
    transform: translateY(-1px);
  }

  .mobile-menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .mobile-menu-btn:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  /* Mobile Dropdown Panel */
  .mobile-dropdown-panel {
    display: none;
    flex-direction: column;
    gap: 16px;
    margin-top: 10px;
    padding: 20px;
    border-radius: 20px;
    width: 100%;
    animation: fadeInDown 0.25s ease forwards;
  }

  .mobile-dropdown-panel.open {
    display: flex;
  }

  @keyframes fadeInDown {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mobile-links-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .mobile-nav-link {
    font-size: 15px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
    padding: 8px 12px;
    border-radius: 10px;
    transition: all 0.2s ease;
  }

  .mobile-nav-link:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
  }

  .mobile-nav-link.tikal-highlight {
    color: #ffffff;
    font-weight: 600;
  }

  .mobile-menu-footer {
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .mobile-download-btn {
    display: block;
    text-align: center;
    width: 100%;
    padding: 10px;
  }

  @media (max-width: 900px) {
    .nav-center-links {
      display: none;
    }

    .desktop-only {
      display: none;
    }

    .mobile-menu-btn {
      display: flex;
    }
  }

  /* Center Meeting Hero Area */
  .hero-meeting-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    max-width: 980px;
    margin: 28px auto 20px auto;
    padding: 0 16px;
  }

  .meeting-status-tag {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 18px;
    border-radius: var(--radius-pill);
    font-size: 13px;
    font-weight: 500;
    color: #ffffff;
    margin-bottom: 16px;
  }

  .live-pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #ef4444;
    box-shadow: 0 0 6px #ef4444;
    animation: blink 1.5s infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .hero-instrument-title {
    font-family: var(--font-serif);
    font-size: 64px;
    line-height: 1.06;
    letter-spacing: 0;
    color: #ffffff;
    margin-bottom: 12px;
    font-weight: 400;
    max-width: 900px;
  }

  .hero-promise {
    font-size: 28px;
    line-height: 1.25;
    color: #b6e7d4;
    margin-bottom: 16px;
    text-wrap: balance;
  }

  .hero-description {
    max-width: 660px;
    color: #d3dedb;
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 20px;
    text-wrap: pretty;
  }

  /* Floating Subtitle HUD */
  .meeting-hud-box {
    width: 100%;
    max-width: 720px;
    border-radius: 8px;
    padding: 20px 24px;
    margin-bottom: 24px;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .hud-header-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0;
    color: rgba(255, 255, 255, 0.7);
  }

  .hud-channel-group {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .hud-badge-latency {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.12);
    padding: 2px 8px;
    border-radius: var(--radius-pill);
  }

  .hud-subtitles-stream {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .subtitle-es {
    font-size: 14.5px;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.4;
  }

  .subtitle-en {
    font-size: 16px;
    color: #ffffff;
    font-weight: 500;
    line-height: 1.4;
  }

  .hud-footer-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.6);
    padding-top: 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .hud-sink-info-group {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .waveform-bars {
    display: flex;
    align-items: center;
    gap: 3px;
    height: 16px;
  }

  .w-bar {
    width: 3px;
    height: 8px;
    background-color: #ffffff;
    border-radius: 2px;
    animation: wave-anim 1.2s infinite ease-in-out;
  }

  .w-bar:nth-child(2) { animation-delay: 0.2s; }
  .w-bar:nth-child(3) { animation-delay: 0.4s; }
  .w-bar:nth-child(4) { animation-delay: 0.6s; }
  .w-bar:nth-child(5) { animation-delay: 0.8s; }

  @keyframes wave-anim {
    0%, 100% { height: 4px; }
    50% { height: 16px; }
  }

  /* CTA Input Bar */
  .hero-cta-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    width: 100%;
    max-width: 680px;
  }

  .cta-input-bar {
    width: 100%;
    border-radius: var(--radius-pill);
    padding: 6px 6px 6px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .cta-input-text {
    background: transparent;
    border: none;
    outline: none;
    color: #ffffff;
    font-size: 14.5px;
    font-family: var(--font-body);
    width: 100%;
  }

  .cta-submit-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: #ffffff;
    color: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .cta-submit-btn:hover {
    transform: scale(1.08);
  }

  .cta-subtext {
    font-size: 13.5px;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.5;
  }

  .btn-manifesto {
    padding: 10px 28px;
    border-radius: var(--radius-pill);
    color: #ffffff;
    font-size: 13.5px;
    font-weight: 500;
    transition: background 0.2s ease;
  }

  .btn-manifesto:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  /* Bottom Call Controls Dock */
  .meeting-call-controls-bar {
    display: none;
    justify-content: center;
    padding-bottom: 16px;
  }

  .meeting-dock-inner {
    border-radius: var(--radius-pill);
    padding: 10px 20px;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .dock-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .dock-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    color: #ffffff;
    transform: scale(1.05);
  }

  .dock-btn.active {
    background: rgba(255, 255, 255, 0.25);
    color: #ffffff;
  }

  .dock-btn.end-call {
    background: #ef4444;
    color: #ffffff;
    border-color: #ef4444;
  }

  .dock-btn.end-call:hover {
    background: #dc2626;
  }

  .hero-cta-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .cta-platform {
    font-size: 12.5px;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.5;
  }

  .hero-cta-buttons .btn-pill-primary {
    background: #c7f7d8;
    color: #102e2b;
    border-color: #c7f7d8;
  }

  .hero-cta-buttons .btn-pill-secondary {
    background: transparent;
    color: #ffffff;
    border-color: #8da49e;
  }

  .hero-cta-buttons .btn-pill-secondary:hover { background: #254a40; }
  .hero-cta-buttons .btn-pill-primary:hover { background: #a9eec1; }

  @media (max-width: 600px) {
    .hero-foreground-content { padding: 16px; }
    .nav-bar-inner { padding: 12px 16px; gap: 12px; }
    .brand-name { font-size: 14px; }
    .nav-right-actions { gap: 10px; }
