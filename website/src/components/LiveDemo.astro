---
import { t } from '../i18n';
const views = [
  { id: 'live', label: 'Traducción', key: 'demo-tab-live', image: 'm06-en-vivo-claro.png', alt: 'shot-m06-alt', description: 'demo-caption-live', caption: 'Tu conversación, con el original y la traducción en el mismo lugar.' },
  { id: 'overlay', label: 'Subtítulos flotantes', key: 'demo-tab-overlay', image: 'w04-subtitulos-flotantes.png', alt: 'demo-overlay-alt', description: 'demo-caption-overlay', caption: 'Una ventana de subtítulos que puedes mantener sobre tu reunión.' },
  { id: 'practice', label: 'Práctica de entrevistas', key: 'demo-tab-practice', image: 'm08-practica-preparacion.png', alt: 'shot-m08-alt', description: 'demo-caption-practice', caption: 'Preparación de entrevistas. Función en desarrollo; confirma su disponibilidad en la versión entregada.' }
];
---

<section id="demo" class="section-editorial product-demo" aria-labelledby="demo-title">
  <div class="container">
    <div class="demo-heading">
      <div class="section-label" data-i18n="demo-label">{t("demo-label")}</div>
      <h2 id="demo-title" data-i18n="demo-title">{t("demo-title")}</h2>
      <p data-i18n="demo-intro">{t("demo-intro")}</p>
    </div>
    <div class="demo-layout">
      <div class="demo-gallery">
        <div class="demo-tabs" role="tablist" aria-label="Vistas del producto / Product views">
          {views.map((view, index) => (
            <button type="button" id={`tab-${view.id}`} role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`panel-${view.id}`} tabindex={index === 0 ? 0 : -1} data-i18n={view.key}>{t(view.key)}</button>
          ))}
        </div>
        {views.map((view, index) => (
          <figure id={`panel-${view.id}`} role="tabpanel" aria-labelledby={`tab-${view.id}`} tabindex="0" hidden={index !== 0}>
            <div class="demo-image-stage">
              <img src={`/images/${view.image}`} alt={t(view.alt)} data-i18n-alt={view.alt} loading="lazy" decoding="async" />
            </div>
            <figcaption data-i18n={view.description}>{t(view.description)}</figcaption>
          </figure>
        ))}
      </div>
      <div class="demo-context">
        <p class="demo-kicker" data-i18n="demo-context-label">{t("demo-context-label")}</p>
        <h3 data-i18n="demo-context-title">{t("demo-context-title")}</h3>
        <dl>
          <div>
            <dt data-i18n="demo-point-1-title">{t("demo-point-1-title")}</dt>
            <dd data-i18n="demo-point-1-desc">{t("demo-point-1-desc")}</dd>
          </div>
          <div>
            <dt data-i18n="demo-point-2-title">{t("demo-point-2-title")}</dt>
            <dd data-i18n="demo-point-2-desc">{t("demo-point-2-desc")}</dd>
          </div>
          <div>
            <dt data-i18n="demo-point-3-title">{t("demo-point-3-title")}</dt>
            <dd data-i18n="demo-point-3-desc">{t("demo-point-3-desc")}</dd>
          </div>
        </dl>
        <a href="#downloads" class="demo-next" data-i18n="demo-next">{t("demo-next")}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .product-demo { background: #eef4f1; }
  .demo-heading { max-width: 760px; margin-bottom: 32px; }
  .demo-heading p { margin-top: 16px; }
  .demo-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr); gap: 64px; align-items: center; }
  .demo-gallery { min-width: 0; }
  .demo-tabs { display: flex; border-bottom: 1px solid #becdc6; margin-bottom: 24px; }
  .demo-tabs button { flex: 1; min-height: 56px; padding: 10px 8px; border-bottom: 2px solid transparent; font-size: 13px; font-weight: 500; color: #485e55; }
  .demo-tabs button[aria-selected="true"] { color: #123d2e; border-bottom-color: #123d2e; }
  .demo-image-stage { height: 480px; display: flex; align-items: center; justify-content: center; }
  .demo-image-stage img { display: block; max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; border: 1px solid #d5ded9; border-radius: 8px; }
  figcaption { min-height: 56px; margin-top: 20px; font-size: 13px; line-height: 1.5; color: #485e55; text-align: center; }
  .demo-kicker { font-family: var(--font-mono); font-size: 12px; color: #315746; margin-bottom: 16px; }
  .demo-context h3 { font-family: var(--font-serif); font-size: 36px; line-height: 1.15; font-weight: 400; }
  dl { margin: 28px 0; }
  dl > div { padding: 20px 0; border-top: 1px solid #cbd9d1; }
  dt { font-weight: 600; font-size: 15px; margin-bottom: 8px; }
  dd { font-size: 14px; line-height: 1.65; color: #485e55; }
  .demo-next { display: inline-block; font-size: 14px; color: #123d2e; font-weight: 600; padding: 10px 0; text-decoration: underline; text-underline-offset: 5px; }
  @media (max-width: 860px) {
    .demo-layout { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .demo-context h3 { font-size: 30px; }
    .demo-image-stage { height: 420px; }
    .demo-tabs button { font-size: 12px; }
  }
</style>

<script>
  const gallery = document.querySelector('.demo-gallery');
  if (gallery) {
    const tabs = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(gallery.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    function selectTab(selected: HTMLButtonElement) {
      tabs.forEach(tab => {
        const active = tab === selected;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
      });
      panels.forEach(panel => { panel.hidden = panel.id !== selected.getAttribute('aria-controls'); });
    }
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectTab(tab));
      tab.addEventListener('keydown', event => {
        let next = index;
        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault();
        selectTab(tabs[next]);
        tabs[next].focus();
      });
    });
  }
</script>