---
interface Props {
  fullHero?: boolean;
}

const { fullHero = true } = Astro.props;
---

<div class={`voice-orb-backdrop ${fullHero ? 'full-hero-mode' : ''}`}>
  <canvas id="voice-orb-canvas" class="voice-orb-canvas"></canvas>
  <div class="voice-orb-ambient-glow"></div>
</div>

<style>
  .voice-orb-backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .voice-orb-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: auto;
  }

  .voice-orb-ambient-glow {
    position: absolute;
    width: min(900px, 90vw);
    height: min(900px, 90vw);
    border-radius: 50%;
    background: radial-gradient(
      circle at 50% 50%,
      rgba(0, 210, 198, 0.18) 0%,
      rgba(203, 255, 252, 0.08) 35%,
      rgba(253, 233, 255, 0.04) 60%,
      transparent 75%
    );
    filter: blur(50px);
    pointer-events: none;
    z-index: 0;
    animation: ambient-voice-breathe 6s infinite ease-in-out;
  }

  @keyframes ambient-voice-breathe {
    0%, 100% {
      opacity: 0.55;
      transform: scale(0.9) translate3d(0, 0, 0);
    }
    50% {
      opacity: 0.95;
      transform: scale(1.1) translate3d(0, -10px, 0);
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const canvas = document.getElementById('voice-orb-canvas');
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    let width = 0;
    let height = 0;
    let dpr = window.devicePixelRatio || 1;

    function resize() {
      const rect = canvas.parentElement ? canvas.parentElement.getBoundingClientRect() : canvas.getBoundingClientRect();
      width = rect.width || window.innerWidth;
      height = rect.height || window.innerHeight;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.scale(dpr, dpr);
    }

    resize();
    window.addEventListener('resize', resize);

    // ── Generate Expansive 3D Voice Particle System (1,400 points) ──
    const particleCount = 1400;
    let baseRadius = Math.min(width, height) * 0.46;
    if (baseRadius < 180) baseRadius = 180;
    if (baseRadius > 440) baseRadius = 440;

    const particles = [];

    // Spherical fibonacci spiral for perfect 3D volume distribution
    for (let i = 0; i < particleCount; i++) {
      const phi = Math.acos(1 - 2 * (i + 0.5) / particleCount);
      const theta = Math.PI * (1 + Math.sqrt(5)) * i;

      // Varied radius layers to create deep volume
      const layerVariance = 0.75 + Math.random() * 0.5;
      const r = baseRadius * layerVariance;

      particles.push({
        baseX: r * Math.sin(phi) * Math.cos(theta),
        baseY: r * Math.sin(phi) * Math.sin(theta),
        baseZ: r * Math.cos(phi),
        freqOffset: Math.random() * Math.PI * 2,
        freqSpeed: 0.02 + Math.random() * 0.04,
        size: 0.8 + Math.random() * 2.2,
        colorType: Math.random() // 0: teal-cyan, 1: aqua-aurora, 2: lavender, 3: white
      });
    }

    let rotX = 0.15;
    let rotY = 0;
    let targetRotX = 0.15;
    let targetRotY = 0;
    let isMouseActive = false;
    let voiceActivity = 1.0;
    let time = 0;

    // Window-wide cursor tracking for full-hero parallax
    window.addEventListener('mousemove', (e) => {
      isMouseActive = true;
      const nx = (e.clientX / window.innerWidth - 0.5) * 2;
      const ny = (e.clientY / window.innerHeight - 0.5) * 2;
      targetRotY = nx * 0.9;
      targetRotX = -ny * 0.6;
    });

    // Touch support for mobile devices
    window.addEventListener('touchmove', (e) => {
      if (e.touches.length > 0) {
        const t = e.touches[0];
        const nx = (t.clientX / window.innerWidth - 0.5) * 2;
        const ny = (t.clientY / window.innerHeight - 0.5) * 2;
        targetRotY = nx * 0.7;
        targetRotX = -ny * 0.5;
      }
    }, { passive: true });

    // Listen to voice simulation events
    window.addEventListener('vibetranslate-voice-pulse', () => {
      voiceActivity = 2.8;
      setTimeout(() => { voiceActivity = 1.0; }, 1800);
    });

    // ── Render Loop ────────────────────────────────────────────────
    function render() {
      time += 0.02;

      // Gentle continuous rotation when mouse is idle
      targetRotY += 0.003;
      targetRotX = Math.sin(time * 0.4) * 0.12;

      rotX += (targetRotX - rotX) * 0.045;
      rotY += (targetRotY - rotY) * 0.045;

      ctx.clearRect(0, 0, width, height);

      const cx = width / 2;
      const cy = height * 0.48; // Centered gracefully with hero content
      const fov = 480;

      const sinX = Math.sin(rotX);
      const cosX = Math.cos(rotX);
      const sinY = Math.sin(rotY);
      const cosY = Math.cos(rotY);

      const projected = [];

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];

        // Complex Harmonic Voice Formant Waves (Frequency Oscillation)
        const wave1 = Math.sin(time * 2.2 + p.freqOffset) * 14 * voiceActivity;
        const wave2 = Math.cos(time * 3.4 + p.baseZ * 0.03) * 10 * voiceActivity;
        const wave3 = Math.sin(time * 1.5 + p.baseY * 0.02) * 8 * voiceActivity;

        const displacement = 1 + (wave1 + wave2 + wave3) / baseRadius;

        const curX = p.baseX * displacement;
        const curY = p.baseY * displacement;
        const curZ = p.baseZ * displacement;

        // 3D Rotation Matrix
        const x1 = curX * cosY + curZ * sinY;
        const z1 = -curX * sinY + curZ * cosY;

        const y2 = curY * cosX - z1 * sinX;
        const z2 = curY * sinX + z1 * cosX;

        // Perspective
        const scale = fov / (fov + z2 + 220);
        const projX = cx + x1 * scale;
        const projY = cy + y2 * scale;

        projected.push({
          x: projX,
          y: projY,
          z: z2,
          scale: scale,
          size: p.size * scale,
          colorType: p.colorType,
          alpha: Math.max(0.1, Math.min(1, (z2 + baseRadius) / (2 * baseRadius) + 0.25))
        });
      }

      projected.sort((a, b) => a.z - b.z);

      // Draw Glowing Particles
      for (let i = 0; i < projected.length; i++) {
        const p = projected[i];

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);

        if (p.colorType < 0.45) {
          // Bioluminescent Teal-Cyan (#00d2c6)
          ctx.fillStyle = `rgba(0, 210, 198, ${p.alpha})`;
          ctx.shadowColor = '#00d2c6';
          ctx.shadowBlur = 5 * p.scale;
        } else if (p.colorType < 0.75) {
          // Pale Aqua Aurora (#cbfffc)
          ctx.fillStyle = `rgba(203, 255, 252, ${p.alpha * 0.95})`;
          ctx.shadowColor = '#cbfffc';
          ctx.shadowBlur = 4 * p.scale;
        } else if (p.colorType < 0.9) {
          // Lavender Phosphor Accent (#fde9ff)
          ctx.fillStyle = `rgba(253, 233, 255, ${p.alpha * 0.85})`;
          ctx.shadowColor = '#fde9ff';
          ctx.shadowBlur = 4 * p.scale;
        } else {
          // Pure White (#ffffff)
          ctx.fillStyle = `rgba(255, 255, 255, ${p.alpha * 0.9})`;
          ctx.shadowColor = '#ffffff';
          ctx.shadowBlur = 3 * p.scale;
        }

        ctx.fill();
        ctx.shadowBlur = 0;
      }

      requestAnimationFrame(render);
    }

    render();
  });
</script>
