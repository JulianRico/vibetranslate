---
const platforms = [
  {
    name: "Google Meet",
    roleKey: "plat-1-role",
    role: "Navegador o escritorio",
    descKey: "plat-1-desc",
    desc: "En los ajustes de audio de Google Meet, elige 'CABLE Output' como micrófono. La reunión recibe la traducción en inglés.",
    checkKeys: ["plat-1-c1", "plat-1-c2", "plat-1-c3"],
    checklist: ["Traducción en vivo", "Subtítulos en tu pantalla", "Requiere VB-CABLE"]
  },
  {
    name: "Microsoft Teams",
    roleKey: "plat-2-role",
    role: "Aplicación de escritorio o web",
    descKey: "plat-2-desc",
    desc: "En la configuración de audio de Teams, elige 'CABLE Output' como micrófono. Teams recibe la voz traducida.",
    checkKeys: ["plat-2-c1", "plat-2-c2", "plat-2-c3"],
    checklist: ["Traducción en vivo", "Subtítulos en tu pantalla", "Requiere VB-CABLE"]
  },
  {
    name: "Zoom",
    roleKey: "plat-3-role",
    role: "Aplicación de escritorio",
    descKey: "plat-3-desc",
    desc: "En Configuración → Audio, elige 'CABLE Output' como micrófono de tu reunión en Zoom.",
    checkKeys: ["plat-3-c1", "plat-3-c2", "plat-3-c3"],
    checklist: ["Traducción en vivo", "Subtítulos en tu pantalla", "Requiere VB-CABLE"]
  }
];
---
<section id="platforms" class="section-editorial">
  <div class="container">
    <div class="section-header-editorial">
      <div class="section-label" data-i18n="plat-label">Compatibilidad</div>
      <h2 data-i18n="plat-title">Funciona con Google Meet, Microsoft Teams <span style="font-weight: 400;">y Zoom</span>.</h2>
      <p class="platforms-subtitle" data-i18n="plat-subtitle">
        La app muestra los subtítulos en tu pantalla. Para que la reunión escuche la traducción, usa VB-CABLE como micrófono.
      </p>
    </div>
    <div class="platforms-editorial-grid">
      {platforms.map((p) => (
        <div class="card-taupe platform-editorial-card">
          <div>
            <div class="platform-top">
              <span class="platform-name">{p.name}</span>
              <span class="mono-tag" data-i18n={p.roleKey}>{p.role}</span>
            </div>
            <p class="platform-desc" data-i18n={p.descKey}>{p.desc}</p>
          </div>
          <div class="platform-checklist">
            {p.checklist.map((item, idx) => (
              <div class="checklist-row">
                <span data-i18n={p.checkKeys[idx]}>{item}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
  <hr class="hairline-divider" style="margin-top: var(--spacing-96);" />
</section>
<style>
  .platforms-subtitle {
    margin-top: var(--spacing-12);
    max-width: 640px;
  }

  .platforms-editorial-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @media (max-width: 980px) {
    .platforms-editorial-grid {
      grid-template-columns: 1fr;
    }
  }

  .platform-editorial-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    padding: 38px 34px;
    border-radius: 20px;
  }

  @media (max-width: 768px) {
    .platform-editorial-card {
      padding: 28px 24px;
    }
  }

  .platform-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--spacing-12);
  }

  .platform-name {
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 600;
    color: var(--color-ink);
  }

  .platform-desc {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--color-graphite);
  }

  .platform-checklist {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: var(--spacing-16);
    border-top: 1px solid var(--color-stone);
  }

  .checklist-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13.5px;
    color: var(--color-smoke);
  }

  .check-icon-svg {
    color: var(--color-ink);
    flex-shrink: 0;
  }
</style>
