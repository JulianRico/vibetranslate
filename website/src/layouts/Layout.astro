---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const {
  title = "ViBeTranslate Pro | Traducción español-inglés para reuniones",
  description = "Habla en español y presenta tu propuesta en inglés con voz traducida y subtítulos en tu PC. Para Windows 10/11, Meet, Teams y Zoom. Consulta acceso por correo.",
  ogImage = "https://vibetranslate.tikal.com.co/images/portal-social-1200x627.png",
  canonicalUrl = "https://vibetranslate.tikal.com.co/"
} = Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "@id": "https://vibetranslate.tikal.com.co/#software",
      "name": "ViBeTranslate Pro",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Windows 10, Windows 11",
      "description": "Traducción entre español e inglés con voz y subtítulos locales para explicar decisiones técnicas y presentar propuestas a clientes. Para Windows 10 y 11, junto a Google Meet, Microsoft Teams y Zoom. El acceso y las condiciones se consultan por correo.",
      "url": "https://vibetranslate.tikal.com.co/",
      "author": {
        "@type": "Organization",
        "name": "Tikal Solutions",
        "url": "https://tikal.com.co"
      },
      "featureList": [
        "Traducción entre español e inglés para reuniones técnicas y con clientes",
        "Subtítulos locales en la pantalla del usuario, no visibles automáticamente para los demás",
        "Voz traducida para Google Meet, Microsoft Teams y Zoom, con audio configurado",
        "Diccionario de apoyo para términos técnicos de Microsoft 365",
        "Refinamiento opcional en la nube, sujeto a condiciones del proveedor",
        "Entrenador de entrevistas en desarrollo; disponibilidad según la versión entregada",
        "Registro de la conversación con el original y la traducción"
      ]
    },
    {
      "@type": "Organization",
      "@id": "https://tikal.com.co/#organization",
      "name": "Tikal Solutions",
      "url": "https://tikal.com.co",
      "logo": "https://vibetranslate.tikal.com.co/favicon.svg"
    },
    {
      "@type": "FAQPage",
      "@id": "https://vibetranslate.tikal.com.co/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Qué hace ViBeTranslate Pro?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Traduce entre español e inglés con voz y subtítulos en tu PC. Te ayuda a explicar una decisión técnica, presentar una propuesta o seguir una conversación. La traducción puede contener errores: confirma los puntos importantes."
          }
        },
        {
          "@type": "Question",
          "name": "¿En qué reuniones funciona?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Con Google Meet, Microsoft Teams y Zoom en Windows 10 y 11. Con el audio configurado, puedes enviar voz traducida a la reunión. Los subtítulos son locales: no aparecen automáticamente en las pantallas de los demás. Prueba la configuración antes de una llamada importante."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué necesito para instalarlo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Windows 10 u 11 y VB-CABLE para enviar la voz traducida a la reunión. La primera descarga de modelos requiere internet. El refinamiento opcional en la nube usa tu clave de Groq y está sujeto a las condiciones y límites del proveedor. Confirma los requisitos de la versión entregada al consultar el acceso."
          }
        },
        {
          "@type": "Question",
          "name": "¿Las conversaciones salen de la computadora?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depende de los servicios que actives. El reconocimiento local se ejecuta en tu PC; el reconocimiento en la nube puede enviar audio al proveedor. La traducción, el refinamiento y la síntesis de voz en la nube envían texto al servicio elegido. No asumas que todo funciona sin nube: revisa la configuración, las condiciones del proveedor y las políticas de tu empresa antes de tratar información sensible."
          }
        },
        {
          "@type": "Question",
          "name": "¿Sirve para preparar entrevistas en inglés?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El entrenador de entrevistas está en desarrollo y su disponibilidad depende de la versión entregada. Está pensado para ensayar preguntas en inglés y respuestas en español con traducción. La evaluación sobre 10 es orientativa: no es una nota garantizada ni predice una contratación. En una entrevista real, usa estas herramientas solo con permiso escrito de la empresa."
          }
        },
        {
          "@type": "Question",
          "name": "¿Reemplaza a un intérprete profesional?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Es una herramienta de apoyo y puede cometer errores. No ofrece interpretación certificada ni sustituye la revisión profesional cuando un contrato, una negociación o un proceso legal la requieren."
          }
        },
        {
          "@type": "Question",
          "name": "¿La app distingue quién está hablando?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La separación de hablantes sigue en desarrollo y pruebas. Intenta distinguir participantes, pero todavía no es fiable para atribuir intervenciones o acuerdos. No dependas de ella para identificar quién dijo algo."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo consulto el acceso o una cotización?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Escribe a vivian@tikal.com.co con tu caso de uso y el número de personas. El formulario prepara un correo que debes enviar tú. El acceso, la versión, el precio y las condiciones se confirman por correo; no hay compra ni descarga automática. La cotización para equipos depende del número de usuarios."
          }
        }
      ]
    }
  ]
};
---

<!doctype html>
<html lang="es" prefix="og: https://ogp.me/ns#">
  <head>
    <!-- Essential Meta Tags -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#012624" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
        <meta name="keywords" content="ViBeTranslate Pro, traducción español inglés, reuniones técnicas, propuestas a clientes, traducción por voz, subtítulos locales, Windows 10, Windows 11, Google Meet, Microsoft Teams, Zoom, Tikal Solutions" />
    <meta name="author" content="Tikal Solutions (tikal.com.co)" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- AI Agents & LLM Discovery Files -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM Context" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="Full LLM Context" />
    <link rel="alternate" hreflang="es" href="https://vibetranslate.tikal.com.co/" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="627" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:site_name" content="ViBeTranslate Pro: por Tikal Solutions" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- JSON-LD Structured Data for AI & Search Engines -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <slot />
  </body>
</html>
